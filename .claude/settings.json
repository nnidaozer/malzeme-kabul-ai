{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/data/gold/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/scripts/hooks/calistir.sh\" gold_koruma.py",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/scripts/hooks/calistir.sh\" tests_kilidi.py",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
